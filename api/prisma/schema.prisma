generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())

  reviews Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  description     String?
  publishedYear   Int?
  copiesAvailable Int      @default(1)
  createdAt       DateTime @default(now())

  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  reviews Review[]

  @@unique([title, author])
  @@index([genreId])
}

// Stretch: reviews link a user to a book (many-to-many through this table)
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  bookId Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId]) // one review per user per book
  @@index([userId])
}
